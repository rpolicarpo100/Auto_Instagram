# Instagram AI Factory — environment template
# Copy to .env and fill real values. Never commit secrets.

# App
APP_ENV=development
APP_NAME=instagram-ai-factory
LOG_LEVEL=info

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Public origin of the API (used in CORS). Leave empty to allow local Vite only.
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Database (Phase 04+) — leave unset until configured
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/instagram_ai_factory

# Render / production
# PORT is provided by Render automatically

# Meta / Instagram (Phase 08+) — official OAuth only
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=

# Object storage (optional later)
# STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
