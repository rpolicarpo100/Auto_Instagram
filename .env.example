# Instagram AI Factory — environment template
# Copy to .env and fill real values. Never commit secrets.

APP_ENV=development
APP_NAME=instagram-ai-factory
LOG_LEVEL=info

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

VITE_API_BASE_URL=http://localhost:8000

# Required for auth and Instagram token storage
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/instagram_ai_factory
SESSION_SECRET=change-me-long-random
